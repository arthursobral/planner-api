# Copie para `.env` (nunca versionado) e preencha com valores seus.

DATABASE_URL=postgresql+psycopg://planner:planner@db:5432/planner
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Usuário único do app. Gere o hash com:
#   python -c "from app.security import hash_password; print(hash_password('sua-senha'))"
# O hash bcrypt tem "$" (ex.: $2b$12$...). O docker compose interpola "$" em
# arquivos .env, então troque cada "$" por "$$" ao colar o hash aqui — senão
# ele vira variável de ambiente vazia e o login falha.
ADMIN_USER=arthur
ADMIN_PASSWORD_HASH=

# true só em dev/CI — nunca ligar num ambiente com dado real, o seed cria
# pessoas fictícias via Faker.
SEED_DEMO_DATA=true

# RAG (Fase 2): geração local via Ollama, sem API paga. O host "ollama" só
# existe dentro da rede do docker-compose; ajuste se rodar fora dele.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
